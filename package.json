{
  "name": "agent-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Delegate a coding task from any MCP client (Cursor, VS Code, Windsurf, Zed, Claude Code, CI) to an isolated microsandbox microVM and run Claude Code inside it.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agent-sandbox-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "bake": "node dist/bake-snapshot.js",
    "bench": "node dist/bench.js",
    "pool:warm": "node dist/pool-warm.js",
    "pool:status": "node dist/pool-status.js",
    "monitor": "node dist/monitor-cli.js",
    "watch": "node dist/watch-cli.js",
    "ask": "node dist/ask-cli.js",
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/compression": "^1.8.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0"
  }
}
