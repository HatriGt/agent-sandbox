# Copy to .env (gitignored). Consumed by the orchestrator/delegate on the VPS.
# Real secrets NEVER get committed and are injected into boxes short-lived.

# ccproxy endpoint for the in-box agent's model calls
ANTHROPIC_BASE_URL=https://your-ccproxy.example.com
# Whatever auth ccproxy expects (leave blank here; set in real .env)
ANTHROPIC_AUTH_TOKEN=

# Short-lived creds injected into the box only for the task duration
GIT_TOKEN=
NPM_TOKEN=

# msb location on the host
MSB=/root/.local/bin/msb
