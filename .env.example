# Copy to .env (gitignored). Consumed by the MCP orchestrator.
# Real secrets NEVER get committed and are injected into boxes short-lived (on `msb exec`).

# --- Where the orchestrator runs vs. where you edit code -----------------------------
# The MCP runs on the VPS and drives msb locally, but your editable working tree lives on
# your Mac. `delegate` rsyncs the local tree to a staging dir on the VPS, then msb copies it
# into the box at boot via --copy-dir.
#
# SSH target to reach the VPS host and run msb.
#   - Local/stdio (Cursor on your Mac): an ssh alias or user@host, e.g. user@your-vps
#   - Docker/compose deploy: the container SSHes to its own host, so use:
#       VPS_SSH=root@host.docker.internal   (compose adds the host-gateway mapping)
VPS_SSH=user@your-vps
# Base dir on the VPS where each delegation's working tree is staged before --copy-dir.
VPS_STAGING_DIR=/root/agent-sandbox-staging
# Local/stdio only: the IDE-provided open project path, so "delegate this" needs no repo arg.
# In ~/.cursor/mcp.json set  env.WORKSPACE_DIR = "${workspaceFolder}"  (Cursor expands it).
# Ignored unless it resolves to a real absolute path; then git/remote must still name the repo.
# WORKSPACE_DIR=${workspaceFolder}
# Keep the multiplexed SSH master connection warm this long (ssh ControlPersist syntax).
# Connection reuse turns ~2s/handshake into ~0.4s, cutting boot-to-ready dramatically.
SSH_PERSIST=120
# Extra ssh args for the CONTAINERIZED HTTP controller (it SSHes to the VPS host to run msb).
# Point at the mounted key + accept the host key on first use. Leave empty for stdio/local use.
# SSH_EXTRA_OPTS=-i /root/.ssh/id_ed25519 -o StrictHostKeyChecking=accept-new

# --- HTTP entry (remote clients: Cursor remote MCP / Claude web / CI) `npm run start:http` ----
# Bearer token REQUIRED to start the HTTP entry (fail-closed). Long + random; rotate on leak.
# Generate: openssl rand -hex 32
MCP_HTTP_TOKEN=
# Optional: a separate bearer for the dashboard's JSON routes (defaults to MCP_HTTP_TOKEN). Set it so the
# browser credential can be rotated without touching IDE/MCP clients.
# DASHBOARD_TOKEN=

# ---- Multi-user mode (docs/saas-design.md) ------------------------------------------------------
# AUTH_MODE=token (default) keeps the single operator token. AUTH_MODE=saas turns on sign-in with
# GitHub, HttpOnly session cookies, per-user API keys (for IDE/MCP clients), box ownership and quotas.
# The operator token keeps working in saas mode as the break-glass / automation identity.
# AUTH_MODE=saas
# PUBLIC_URL=https://agent-sandbox.example.com        # defaults to https://$ASB_DOMAIN
# GITHUB_OAUTH_CLIENT_ID=                             # GitHub OAuth App; callback = $PUBLIC_URL/auth/github/callback
# GITHUB_OAUTH_CLIENT_SECRET=
# USER_MAX_BOXES=2                                    # concurrent machines per user
# ADMIN_GITHUB_LOGINS=hatrigt-atom                    # these logins see and can act on every box
# DATA_DIR=./data                                     # SQLite location (compose mounts ./data)
# Port the HTTP entry binds. In Docker set MCP_HTTP_HOST=0.0.0.0 (compose does this for you).
MCP_HTTP_PORT=8787
# Bind host. Default 127.0.0.1 (safe for local). Container/compose overrides to 0.0.0.0.
# MCP_HTTP_HOST=127.0.0.1

# --- Docker deploy (compose.yaml + Traefik) -----------------------------------------
# Public hostname Traefik routes to this service. Set YOUR domain.
ASB_DOMAIN=agent-sandbox.example.com
# Traefik external network + cert resolver (Dokploy defaults shown).
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_CERTRESOLVER=letsencrypt

# --- msb (microsandbox) on the VPS --------------------------------------------------
MSB=/root/.local/bin/msb
# Base image for boxes (cached on host: node, python).
MSB_IMAGE=node
# Warm-start snapshot with claude+gh pre-baked (see `npm run bake`). Empty = boot from image.
MSB_SNAPSHOT=
# Auto-teardown safety timers on the initial `msb run`.
MSB_IDLE_TIMEOUT=15m
MSB_MAX_DURATION=1h
# Per-box memory cap and max concurrent boxes (host protection).
MSB_MEMORY=1G
MSB_MAX_BOXES=5
# Warm pool: pre-booted+bootstrapped boxes kept idle so delegations skip the ~4s boot.
# 0 disables pooling. Pooled boxes boot with OPEN egress, so the pool is only used when the
# delegation wants open egress (EGRESS_ALLOW_ALL=1 and no per-call allowDomains); restricted
# delegations always cold-boot with their exact allowlist.
MSB_POOL_SIZE=1

# --- egress allowlist ---------------------------------------------------------------
# The box can ONLY reach ccproxy + npm + GitHub + these extra domains (comma-separated).
# ccproxy's host is always allowed automatically.
EGRESS_DOMAINS=
# Set to 1/true to allow the box to reach ANY domain (open egress). Overrides the allowlist.
EGRESS_ALLOW_ALL=

# --- ccproxy: in-box agent model calls (injected on `msb exec`) ----------------------
# Your Anthropic-compatible proxy base URL (e.g. an anthropic-compatible ccproxy route).
ANTHROPIC_BASE_URL=https://your-ccproxy.example.com
# ccproxy's Anthropic route accepts a placeholder key; real auth handled by ccproxy.
ANTHROPIC_API_KEY=dummy
# Pick a current (non-retired) alias from your ccproxy /v1/models.
ANTHROPIC_MODEL=your-model-alias

# --- Credentials injected into the box ------------------------------------------------
# NOTE: There is NO default GitHub account. Git push + commit identity + `gh` come from the
# login-keyed token store (~/.agent-sandbox/gh-tokens.json on the VPS), resolved per repo by ACCESS.
# delegate asks for a token on demand the first time a repo needs one. So no GH_TOKEN / GIT_AUTHOR_*
# here — they were removed on purpose.
# Optional npm auth for publishing to the public registry.
NPM_TOKEN=

# Optional: GitHub OAuth App client id enabling "Sign in with GitHub" (device flow) on the dashboard's
# Accounts page. Create an OAuth App at github.com/settings/developers with "Enable Device Flow" ticked.
# No client secret is needed. Without it, accounts are added by pasting a personal access token.
# GITHUB_OAUTH_CLIENT_ID=

# How long a CLAIMED sandbox may stay asleep (idle-stopped, workspace intact, wakeable by a reply)
# before the pool maintainer finally destroys it. Unclaimed warm boxes that stop are reaped at once.
# MSB_SLEEP_TTL=1h
