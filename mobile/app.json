{
  "expo": {
    "name": "Agent Sandbox",
    "slug": "agent-sandbox",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "asb",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0f0f12",
      "resizeMode": "contain",
      "imageWidth": 160
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.ajeethkumar.agentsandbox",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Attach screenshots and photos to delegated tasks.",
        "NSCameraUsageDescription": "Photograph a whiteboard or bug to delegate it as a task."
      }
    },
    "android": {
      "package": "dev.ajeethkumar.agentsandbox",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f12"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f4b99b6-e065-482b-a542-41a09e4927e2"
      }
    }
  }
}
